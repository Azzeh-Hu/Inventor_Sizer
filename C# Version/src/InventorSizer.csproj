<Project Sdk="Microsoft.NET.Sdk">
  <!-- Inventor Sizer (C#). Builds InventorSizer.exe into the repository root, next to
       standards\, masters\, presets\, Parameters.xml and settings.json.
       Visual Studio 2022 or "dotnet build src\InventorSizer.csproj" (any OS; Windows targeting enabled).
       Without either: pwsh tools\build.ps1 -RefDir <.NET 4.8 reference assemblies> (see the script). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>10</LangVersion>
    <AssemblyName>InventorSizer</AssemblyName>
    <RootNamespace>InventorSizer</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <OutputPath>..\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
